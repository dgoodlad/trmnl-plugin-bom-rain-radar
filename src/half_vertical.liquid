{% assign station = trmnl.plugin_settings.custom_fields_values.station_name | default: "" %}
{% if station == "" %}{% assign station = "BOM Radar" %}{% endif %}
{% assign live = radars | where: "ok", true %}
{% assign r = live | first %}
{% if status == "ok" and r %}
<div class="layout layout--col layout--center gap--small">
  <div class="bg--white border bomr-map bomr-map--340 bomr-pan-{{ r.id }}">
    <img class="image bomr-layer bomr-coast" src="{{ r.bg_url }}" onerror="this.style.display='none'" />
    <img class="image image-dither bomr-layer bomr-water" src="{{ r.water_url }}" onerror="this.style.display='none'" />
    <img class="image image-dither bomr-layer bomr-rain" src="{{ r.frame_url }}" onerror="this.style.display='none'" />
    <img class="image bomr-layer" src="{{ r.range_url }}" onerror="this.style.display='none'" />
    {% if r.show_home %}
    <div class="bg--white bomr-x bomr-x--halo-h"></div>
    <div class="bg--white bomr-x bomr-x--halo-v"></div>
    <div class="bg--black bomr-x bomr-x--h"></div>
    <div class="bg--black bomr-x bomr-x--v"></div>
    {% endif %}
    <span class="label label--inverted bomr-tag">{{ r.label }}</span>
  </div>
  <div class="flex flex--row flex--center-y gap">
    <span class="value value--large" data-fit-value="true">{{ r.time }}</span>
    <span class="label label--gray 1bit:text--black">{{ r.date }}</span>
  </div>
</div>
{% else %}
<div class="layout layout--col layout--center gap">
  <span class="value">{{ status_message }}</span>
</div>
{% endif %}
<div class="title_bar">
  <img class="image" src="data:image/png;base64,{{ bomr_icon }}" />
  <span class="title">BOM Radar</span>
  <span class="instance" data-clamp="1">{{ station }}</span>
</div>